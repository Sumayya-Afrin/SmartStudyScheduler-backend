generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // DO NOT add url here. Prisma 7 will throw an error if you do.
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}